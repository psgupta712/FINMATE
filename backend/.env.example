# ──────────────────────────────────────────────
#  FinMate Backend — Environment Variables
#  Copy this file to .env and fill in all values
#  Never commit .env to git
# ──────────────────────────────────────────────

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/finmate?retryWrites=true&w=majority

# JWT secret — must be a long random string (run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_char_random_hex

# Razorpay keys — get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay webhook secret — set in Razorpay dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Groq AI API key — get from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx

# Frontend URL — no trailing slash
# Development:
CLIENT_URL=http://localhost:3000
# Production (replace with your actual domain):
# CLIENT_URL=https://yourapp.vercel.app

# Port (optional — defaults to 5000)
PORT=5000
